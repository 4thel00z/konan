import os
from collections.abc import Awaitable, Callable, Sequence
from typing import Literal, Protocol

class TokenizerLike(Protocol):
    """A Hugging Face `tokenizers.Tokenizer`, or anything serializing to `tokenizer.json`."""

    def to_str(self, pretty: bool = False) -> str: ...

EncodingName = Literal["cl100k_base", "o200k_base"]
SizeEncoding = EncodingName | TokenizerLike | os.PathLike[str]

__version__: str

class Chunk:
    @property
    def text(self) -> str: ...
    @property
    def start(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def index(self) -> int: ...
    @property
    def hash(self) -> str: ...
    @property
    def hash_int(self) -> int: ...
    def __len__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class EmbeddingError(Exception): ...

class NaiveChunker:
    def __init__(self, chunk_size: int = 200) -> None: ...
    def chunk(self, text: str) -> list[Chunk]: ...
    def chunk_many(self, texts: Sequence[str]) -> list[list[Chunk]]: ...
    async def chunk_async(self, text: str) -> list[Chunk]: ...
    async def chunk_many_async(self, texts: Sequence[str]) -> list[list[Chunk]]: ...

class FixedSizeChunker:
    def __init__(
        self,
        chunk_size: int = 1000,
        chunk_overlap: int = 200,
        respect_sentences: bool = True,
        encoding: SizeEncoding | None = None,
        stable_boundaries: bool = False,
    ) -> None: ...
    def chunk(self, text: str) -> list[Chunk]: ...
    def chunk_many(self, texts: Sequence[str]) -> list[list[Chunk]]: ...
    async def chunk_async(self, text: str) -> list[Chunk]: ...
    async def chunk_many_async(self, texts: Sequence[str]) -> list[list[Chunk]]: ...

class RecursiveChunker:
    def __init__(
